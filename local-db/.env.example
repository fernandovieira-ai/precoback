# ============================================================================
# Configuração da base LOCAL de testes (Docker)
# Copie este arquivo para ".env" e ajuste se necessário.
# Estes valores são só para o container local — não são credenciais reais.
# ============================================================================

LOCAL_DB_USER=drftrocapreco_local
LOCAL_DB_PASSWORD=localdev123
LOCAL_DB_NAME=drftrocapreco_local
LOCAL_DB_PORT=5433

# ============================================================================
# Credenciais da base de PRODUÇÃO (somente leitura, usadas pelo script de dump)
# NÃO preencha este exemplo — preencha apenas no seu .env local, que é
# ignorado pelo git.
